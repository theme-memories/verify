# Vercel secret / environment variable names. These exact names must be
# created in the Vercel dashboard (Settings -> Environment Variables) for every
# environment (Production / Preview / Development). All values are read once at
# cold-start; a missing or invalid value makes the deployment fail to boot.

# Pepper mixed into every Argon2 hash. MUST be >= 32 bytes AND MUST match the
# secret the Cloudflare Worker used to originally hash the password, otherwise
# verification always fails. Treat as a secret.
ARGON2_SECRET=replace-with-at-least-32-random-bytes

# HMAC key used to verify the caller's HS256 JWT. MUST be >= 32 bytes and MUST
# match the key the Cloudflare Worker signs tokens with. Treat as a secret.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Expected `iss` claim of incoming JWTs. Must be a real https:// URL.
JWT_ISSUER=https://test.example

# Expected `aud` claim of incoming JWTs. Must be a real https:// URL.
JWT_AUDIENCE=https://test-verify.example

# Route path the verify endpoint is mounted on. Must start with "/" and contain
# only letters, numbers, "_", "-" and "/". No trailing slash.
VERIFY_PATH=/test-path

# Redis connection used for replay (jti) protection. Defaults assume a plain
# (non-TLS) Redis. If your provider requires TLS (e.g. Upstash), update
# src/redis.ts (set socket.tls = true) accordingly.
REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
