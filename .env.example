# Copy to `.env` for local runs / tests, or set these as Vercel Environment Variables.
# All values are REQUIRED; the service fails to start if any are missing or invalid.

# Secret pepper mixed into every Argon2 hash (server-side secret).
# MUST be >= 32 bytes. Must match the value used when the hashes were created.
ARGON2_PEPPER=replace-with-at-least-32-random-bytes

# HMAC secret used to verify the caller's JWT (HS256).
# MUST be >= 32 bytes. Shared with the service that issues these tokens.
JWT_VERIFICATION_SECRET=replace-with-at-least-32-random-bytes

# Expected `iss` (issuer) of incoming JWTs. Must be a valid HTTPS URL.
JWT_ISSUER=https://test.example

# Expected `aud` (audience) of incoming JWTs. Must be a valid HTTPS URL.
JWT_AUDIENCE=https://test-verify.example

# The single path this service exposes, e.g. /verify. Must start with "/" and
# contain only letters, numbers, "_", "-" and "/". Must not end with "/".
VERIFY_PATH=/test-path

# Redis connection used for replay (jti) protection.
# Hostname or IP of the Redis instance.
REDIS_HOST=replace-with-redis-host
# Port (1-65535). 6379 is the Redis default.
REDIS_PORT=6379
# Redis AUTH password (the store connects as the "default" user).
REDIS_PASSWORD=replace-with-redis-password
